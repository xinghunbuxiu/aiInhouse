CODEX_WORKER_MODE=local_pipeline
# 可选值:
# - local_pipeline（生产推荐：项目内置平面图 -> 配置 -> 图片生成流水线，不依赖 Codex CLI）
# - mock（兼容旧名称，等同 local_pipeline）
# - external_command
# - codex_cli
#
# 推荐先使用 codex_cli，再通过参数模板适配你本机真实 codex 命令

# 当切到 external_command 模式时，配置真正的本地 Codex 命令
# 约定:
# 1. 命令会收到 --job <job.json> --output <output-dir>
# 2. 命令执行完成后，需要在 stdout 输出 JSON:
#    {
#      "output": {
#        "formalPlanSvg": "formal-plan.svg",
#        "formalPlanJson": "formal-plan.json",
#        "threeDConfig": "3d-config.json",
#        "panoramaConfig": "panorama-config.json",
#        "reviewFile": "review.md",
#        "previewImage": "preview.svg"
#      },
#      "summary": {
#        "roomCount": 4,
#        "hasFormalPlan": true,
#        "hasThreeD": true,
#        "hasPanorama": true
#      }
#    }
CODEX_REAL_COMMAND=/Applications/ChatGPT.app/Contents/Resources/codex
#
# 当 CODEX_WORKER_MODE=codex_cli 时，可以使用下面的参数模板
# 可用占位符:
# - {{jobFile}}
# - {{outputDir}}
# - {{promptFile}}
# - {{contextFile}}
# - {{resultFile}}
#
# 示例:
# CODEX_REAL_COMMAND=codex
# CODEX_REAL_ARGS_TEMPLATE=exec --ignore-user-config --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C {{outputDir}} --output-schema {{schemaFile}} -
#
# 上面最后的 "-" 表示 prompt 从 stdin 读取，codex-worker 会自动把生成好的 prompt 写进去。
#
# 如果你的 codex 命令不会直接把 JSON 打到 stdout，
# 也可以自行调整参数，让它写入 {{resultFile}}
CODEX_REAL_ARGS_TEMPLATE=
CODEX_RESULT_FILENAME=codex-result.json
BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender
#
# 识别模式:
# - ai_first: 先走 AI 识别，失败后回退到本地识别器或规则草稿
# - ai_only: 只走 AI 识别，失败后直接回退到规则草稿
# - local_only: 跳过 AI，只走本地识别器或规则草稿
CODEX_RECOGNITION_MODE=ai_first
#
# 可选: AI 识别命令，推荐先接你本机 Codex
# 示例:
# CODEX_RECOGNITION_AI_COMMAND=codex
# CODEX_RECOGNITION_AI_ARGS_TEMPLATE=exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -C {{outputDir}} --output-schema {{schemaFile}} -
CODEX_RECOGNITION_AI_COMMAND=
CODEX_RECOGNITION_AI_ARGS_TEMPLATE=
#
# 可选: 图像预处理命令，默认脚本会压缩图片，并在可用时用 OpenCV 提取线段/轮廓/质量评分
# 示例:
# CODEX_RECOGNITION_PREPROCESS_COMMAND=node ../scripts/floorplan-preprocess.mjs
CODEX_RECOGNITION_PREPROCESS_COMMAND=node ../scripts/floorplan-preprocess.mjs
CODEX_RECOGNITION_PREPROCESS_TIMEOUT_MS=90000
#
# 可选: 本地图像识别器命令，适合接 Python/OpenCV 或检测模型
# 命令会收到 --job <job.json> --output <output-dir>
# 识别器需要输出 recognition-draft JSON 到 stdout，或写入 output-dir/recognition-draft.json
# 示例:
# CODEX_RECOGNITION_COMMAND=node ../scripts/floorplan-local-recognizer.mjs
CODEX_RECOGNITION_COMMAND=node ../scripts/floorplan-local-recognizer.mjs
CODEX_RECOGNITION_TIMEOUT_MS=90000

# 3D 装修效果渲染:
# - local_threejs: 默认输出可由前端 Three.js 预览的 3d-config.json
# - external_command: 通过 CODEX_RENDER_COMMAND 接成熟项目/渲染管线
# 推荐成熟项目:
# - Sweet Home 3D: https://www.sweethome3d.com/ 适合室内设计建模与人工/半自动布置
# - BlenderProc: https://github.com/DLR-RM/BlenderProc 适合脚本化批量渲染效果图/全景图
CODEX_RENDER_PROVIDER=local_threejs
CODEX_RENDER_ENDPOINT=
CODEX_RENDER_API_KEY=
# 命令会收到 --job <job-context.json> --scene <3d-config.json> --assembly-plan <scene-assembly-plan.json> --output <output-dir>
# 可输出 JSON 到 stdout 或 output-dir/render-result.json:
# {"output":{"effectImage":"effect.jpg","modelFile":"scene.glb"},"summary":{"provider":"blenderproc"}}
# 本地联调示例:
# CODEX_RENDER_COMMAND=node ../scripts/aiinhouse-local-renderer.mjs
# 本地 raster 验收示例：把 SVG 预览转为满足尺寸门槛的 PNG，不等同照片级渲染
# CODEX_RENDER_COMMAND=node /absolute/path/to/AIInHouse/scripts/aiinhouse-rasterize-renderer.mjs
# Blender 确定性渲染示例：服务器需安装 headless Blender CLI，或设置 BLENDER_BIN=/path/to/blender。
# 自动化渲染禁止使用 macOS .app、open、/opt/homebrew/bin/blender 这类会转调 Blender.app 的包装器。
# 如果只找到桌面客户端入口，渲染器会直接失败，不会打开 Blender.app。
# 如果只想 Blender 渲染，不要用 auto renderer，直接指向 aiinhouse-blender-renderer.mjs。
# CODEX_RENDER_COMMAND=node ../scripts/aiinhouse-blender-renderer.mjs
# 也可以保持 auto renderer，并设置 AIINHOUSE_RENDER_TRY_BLENDER=true，让它按 Blender -> OpenAI 图片 -> raster 兜底顺序尝试。
# AIINHOUSE_RENDER_TRY_BLENDER=true
# OpenAI/imagegen 商用图示例:
# OPENAI_API_KEY=sk-...
# 如使用兼容 OpenAI 的第三方中转，需要在环境变量里写完整 base URL，例如:
# OPENAI_IMAGE_BASE_URL=https://your-compatible-provider.example/v1
# CODEX_IMAGE_MODEL=gpt-image-2
# CODEX_RENDER_COMMAND=node ../scripts/openai-image-renderer.mjs
# 自动模式：有 OPENAI_API_KEY 时走 OpenAI 图片生成，失败或未配置时转本地 PNG 兜底。
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODE=images
CODEX_IMAGE_MODEL=gpt-image-2
CODEX_REQUIRE_OFFICIAL_OPENAI=true
CODEX_IMAGE_USE_REFERENCE=true
OPENAI_IMAGE_REQUEST_TIMEOUT_MS=120000
OPENAI_PANORAMA_IMAGE_REQUEST_TIMEOUT_MS=240000
OPENAI_IMAGE_MAX_RETRIES=1
OPENAI_IMAGE_RETRY_DELAY_MS=2500
CODEX_RENDER_COMMAND=node ../scripts/aiinhouse-auto-renderer.mjs
CODEX_RENDER_TIMEOUT_MS=600000

# 全景 VR 渲染:
# - pannellum: 默认输出可由 Pannellum/前端全景查看器消费的 panorama-config.json
# - external_command: 通过 CODEX_PANORAMA_COMMAND 接 Blender 等全景渲染管线
CODEX_PANORAMA_PROVIDER=pannellum
CODEX_PANORAMA_ENDPOINT=
CODEX_PANORAMA_API_KEY=
# 命令会收到 --job <job-context.json> --panorama <panorama-config.json> --output <output-dir>
# 可输出 JSON 到 stdout 或 output-dir/render-result.json:
# {"output":{"panoramaImage":"living-room-360.jpg","tourFile":"tour.html"},"summary":{"provider":"blender"}}
# OpenAI/imagegen 全景图示例:
# OPENAI_API_KEY=sk-...
# 如使用兼容 OpenAI 的第三方中转，需要在环境变量里写完整 base URL，例如:
# OPENAI_IMAGE_BASE_URL=https://your-compatible-provider.example/v1
# CODEX_IMAGE_MODEL=gpt-image-2
# CODEX_PANORAMA_COMMAND=node ../scripts/openai-image-renderer.mjs
# 本地 raster 验收示例：输出 2048x1024 的 2:1 PNG
# CODEX_PANORAMA_COMMAND=node /absolute/path/to/AIInHouse/scripts/aiinhouse-rasterize-renderer.mjs
# Blender 全景渲染示例：输出 2048x1024 2:1 equirectangular PNG；同样要求 headless CLI，不接受 .app 或包装器。
# CODEX_PANORAMA_COMMAND=node ../scripts/aiinhouse-blender-renderer.mjs
# 自动模式：有 OPENAI_API_KEY 时走 OpenAI 图片生成，失败或未配置时转本地 PNG 兜底。
CODEX_PANORAMA_COMMAND=node ../scripts/aiinhouse-auto-renderer.mjs
CODEX_PANORAMA_TIMEOUT_MS=600000
