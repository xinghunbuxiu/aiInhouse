AIH_BACKEND_URL=http://127.0.0.1:3002/api
AIH_DEVICE_CODE=DESKTOP-SH-001
AIH_DEVICE_NAME=上海设计工作站
AIH_DEVICE_TYPE=desktop
AIH_PROCESSOR_TYPE=codex
AIH_APP_VERSION=0.1.0
AIH_POLL_INTERVAL_MS=8000
AIH_HEARTBEAT_INTERVAL_MS=30000
AIH_USERNAME=admin
AIH_PASSWORD=admin123
AIH_TOKEN=
# 开发环境下如果账号密码无效，worker 会自动回退到 mock-token-12345
AIH_CODEX_COMMAND=node ../codex-worker/src/index.js
AIH_WORKSPACE_DIR=./workspace

# Tauri 桌面版也会使用同一套 worker/codex-worker 配置。
# 上传平面图后，后台会自动创建 full_pipeline 任务；
# worker 领取任务后会产出 formal-plan / CAD / 3d-config / panorama-config。
