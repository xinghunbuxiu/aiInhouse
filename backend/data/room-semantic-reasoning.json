{
  "version": "1.0.0",
  "title": "Room semantic reasoning knowledge",
  "description": "Evidence-based, explainable room-type inference. This knowledge base is not ground-truth geometry; every inference must retain supporting and contradicting evidence.",
  "principles": [
    "A room label is evidence, not unquestionable truth.",
    "Infer room use from combinations of fixtures, furniture, boundary geometry, openings, exterior relationships, and neighboring spaces.",
    "Do not infer a room type from one weak symbol or proximity alone.",
    "Keep semantic confidence separate from geometric confidence.",
    "Contradictory high-impact evidence must trigger review instead of forced classification.",
    "Missing symbols are not negative evidence unless image quality and detector coverage are sufficient.",
    "Store reviewed corrections as versioned cases with regression tests."
  ],
